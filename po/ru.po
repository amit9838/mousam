#: src/core/overview/messages.py:31
msgid "Thunderstorms are likely right now. Stay indoors if you can."
msgstr "Сейчас вероятна гроза. По возможности оставайтесь в помещении."

#: src/core/overview/messages.py:32
msgid "Expect thunderstorms right now. Stay indoors if you can."
msgstr "Сейчас ожидается гроза. По возможности оставайтесь в помещении."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:36
#, python-brace-format
msgid "Thunderstorms are likely around {time}. Plan to be indoors by then."
msgstr ""
"Около {time} вероятна гроза. Постарайтесь к этому времени быть в помещении."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:38
#, python-brace-format
msgid "Expect thunderstorms around {time}. Plan to be indoors by then."
msgstr ""
"Около {time} ожидается гроза. Постарайтесь к этому времени быть в помещении."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:42
#, python-brace-format
msgid ""
"Thunderstorms are likely around {time} with {chance}% chance of rain. Be "
"indoors by then."
msgstr ""
"Около {time} вероятна гроза, вероятность дождя {chance}%. Постарайтесь к "
"этому времени быть в помещении."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:44
#, python-brace-format
msgid ""
"Expect thunderstorms around {time}, with {chance}% chance of rain. Be "
"indoors by then."
msgstr ""
"Около {time} ожидается гроза, вероятность дождя {chance}%. Постарайтесь к "
"этому времени быть в помещении."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "30"
#: src/core/overview/messages.py:48
#, python-brace-format
msgid ""
"Thunderstorms are possible around {time}, with {chance}% chance of rain."
msgstr "Около {time} возможна гроза, вероятность дождя {chance}%."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "30"
#: src/core/overview/messages.py:50
#, python-brace-format
msgid "Thunderstorms may come around {time}, with {chance}% chance of rain."
msgstr "Около {time} может начаться гроза, вероятность дождя {chance}%."

#. Translators: {time} is when the rain eases off, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:55
#, python-brace-format
msgid "Rain right now, turning stormy before it eases off around {time}."
msgstr "Сейчас идёт дождь, он перейдёт в грозу и стихнет около {time}."

#. Translators: {time} is when the rain eases off, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:57
#, python-brace-format
msgid "Rain for now, with thunderstorms before it clears around {time}."
msgstr "Пока идёт дождь, будет гроза, а около {time} прояснится."

#. Translators: {time} is when the rain ends, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:61
