#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:92
#, python-brace-format
msgid "Expect it to feel like {temp} by around {time}. Bundle up."
msgstr ""
"Se espera una sensación térmica de {temp} hacia las {time}. Abrígate bien."

#: src/CORE_OverviewMessages.py:95
msgid "Air quality is unhealthy right now. Limit time outdoors if you can."
msgstr ""
"Ahora mismo la calidad del aire es insalubre. Limita el tiempo al aire libre "
"si puedes."

#: src/CORE_OverviewMessages.py:96
msgid "The air is unhealthy right now. Consider staying indoors."
msgstr "Ahora mismo el aire es insalubre. Considera quedarte en casa."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:100
#, python-brace-format
msgid ""
"Air quality turns unhealthy around {time}. Consider limiting time outdoors."
msgstr ""
"La calidad del aire será insalubre hacia las {time}. Considera limitar el "
"tiempo al aire libre."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:102
#, python-brace-format
msgid "Expect unhealthy air from around {time}. Limit time outdoors."
msgstr ""
"Se espera aire insalubre a partir de las {time}. Limita el tiempo al aire "
"libre."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:106
#, python-brace-format
msgid "UV is very high until about {time}. Use sunscreen and cover up."
msgstr ""
"El índice UV es muy alto hasta las {time} aproximadamente. Usa protector "
"solar y cúbrete."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:108
#, python-brace-format
msgid ""
"The sun is very strong until about {time}. Use sunscreen and seek shade."
msgstr ""
"El sol es muy fuerte hasta las {time} aproximadamente. Usa protector solar y "
"busca la sombra."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:112
#, python-brace-format
msgid ""
"UV will be very high from about {start} to {end}. Use sunscreen outdoors."
msgstr ""
"El índice UV será muy alto aproximadamente de {start} a {end}. Usa protector "
"solar al aire libre."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:114
#, python-brace-format
msgid "Expect very high UV from about {start} to {end}. Cover up outdoors."
msgstr ""
"Se espera un índice UV muy alto aproximadamente de {start} a {end}. Cúbrete "
"al aire libre."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:119
#, python-brace-format
msgid "Rain is likely to start around {time} with {chance}% chance."
msgstr ""
"Es probable que empiece a llover hacia las {time}, con una probabilidad del "
"{chance} %."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:121
#, python-brace-format
msgid "Expect rain from around {time}, with {chance}% chance."
msgstr ""
"Se espera lluvia a partir de las {time}, con una probabilidad del {chance} %."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:123
#, python-brace-format
msgid "Rain may move in around {time} with {chance}% chance."
msgstr ""
"La lluvia puede llegar hacia las {time}, con una probabilidad del {chance} %."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:125
#, python-brace-format
msgid ""
"Showers could begin around {time} with {chance}% chance. Keep an umbrella "
"handy."
msgstr ""
"Los chubascos podrían empezar hacia las {time}, con una probabilidad del "
"{chance} %. Ten el paraguas a mano."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
