#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:588
#, python-brace-format
msgid "Sunrise around {time} comes with falling snow. A peaceful one!"
msgstr ""
"La sortida del sol, cap a les {time}, arriba amb neu. Serà ben plàcida!"

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:592
#, python-brace-format
msgid ""
"A rainy sunrise around {time}. Watch for a rainbow if the sun peeks through!"
msgstr ""
"Una sortida del sol plujosa cap a les {time}. Estigueu atents a l'arc de "
"Sant Martí si el sol treu el cap!"

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:594
#, python-brace-format
msgid "Rain at sunrise, around {time}, a cozy start to the day."
msgstr ""
"Pluja a la sortida del sol, cap a les {time}: un inici de dia acollidor."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:598
#, python-brace-format
msgid "A misty sunrise around {time}, with soft, hazy light."
msgstr ""
"Una sortida del sol boirosa cap a les {time}, amb una llum suau i difusa."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:600
#, python-brace-format
msgid "Fog at sunrise, around {time}, for a soft, hazy view."
msgstr ""
"Boira a la sortida del sol, cap a les {time}, per a una vista suau i difusa."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:604
#, python-brace-format
msgid "A very windy sunrise around {time}, best enjoyed from a sheltered spot."
msgstr ""
"Una sortida del sol amb molt de vent cap a les {time}; millor gaudir-la des "
"d'un lloc resguardat."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:606
#, python-brace-format
msgid "Very strong wind at sunrise, around {time}; enjoy it from shelter."
msgstr ""
"Vent molt fort a la sortida del sol, cap a les {time}; gaudiu-la des d'un "
"lloc arrecerat."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:610
#, python-brace-format
msgid "Clear and windy for sunrise around {time}, with crisp, fresh air."
msgstr ""
"Cel serè i vent per a la sortida del sol, cap a les {time}, amb un aire "
"fresc i net."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:612
#, python-brace-format
msgid "A bright, windy sunrise around {time}. Hold on to your hat!"
msgstr ""
"Una sortida del sol lluminosa i ventosa cap a les {time}. Agafeu-vos el "
"barret!"

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:616
#, python-brace-format
msgid "A windy sunrise around {time}, with a few clouds."
msgstr "Una sortida del sol ventosa cap a les {time}, amb alguns núvols."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:618
#, python-brace-format
msgid "Sunrise around {time} looks windy, with clouds about."
msgstr ""
"La sortida del sol, cap a les {time}, es presenta ventosa i amb núvols."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:622
#, python-brace-format
msgid "A cloudy sunrise around {time}, with soft, even light."
msgstr ""
"Una sortida del sol ennuvolada cap a les {time}, amb una llum suau i "
"uniforme."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:624
#, python-brace-format
msgid "Sunrise around {time} looks cloudy and calm."
msgstr ""
"La sortida del sol, cap a les {time}, es presenta ennuvolada i tranquil·la."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:628
#, python-brace-format
msgid "A few clouds at sunrise, around {time}, could bring some color."
msgstr ""
"Alguns núvols a la sortida del sol, cap a les {time}, li poden donar color."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:630
#, python-brace-format
msgid ""
"Sunrise around {time} brings scattered clouds, often the most colorful kind."
msgstr ""
"La sortida del sol, cap a les {time}, porta núvols dispersos, sovint els que "
"donen més color."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:634
#, python-brace-format
msgid "Clear skies for sunrise around {time}, a great morning to catch it."
msgstr ""
"Cel serè per a la sortida del sol, cap a les {time}: un matí ideal per veure-"
"la."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:636
#, python-brace-format
msgid "Sunrise around {time} looks clear and bright. Worth a look!"
msgstr ""
"La sortida del sol, cap a les {time}, es presenta clara i lluminosa. Val la "
"pena mirar-la!"

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:641
#, python-brace-format
msgid "Conditions should stay steady until about {time}."
msgstr ""
"Les condicions haurien de mantenir-se estables fins a les {time}, "
"aproximadament."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:643
#, python-brace-format
msgid "No big changes expected until about {time}."
msgstr "No s'esperen grans canvis fins a les {time}, aproximadament."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:645
#, python-brace-format
msgid "A quiet spell ahead, with little change until about {time}."
msgstr ""
"S'acosta una estona tranquil·la, amb pocs canvis fins a les {time}, "
"aproximadament."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:647
#, python-brace-format
msgid "Things look settled until about {time}."
msgstr "Tot sembla estable fins a les {time}, aproximadament."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:649
#, python-brace-format
msgid "The weather should hold steady until about {time}."
msgstr ""
"El temps hauria de mantenir-se estable fins a les {time}, aproximadament."

