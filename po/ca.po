#: src/core/overview/messages.py:31
msgid "Thunderstorms are likely right now. Stay indoors if you can."
msgstr ""
"Ara mateix és probable que hi hagi tempestes. Quedeu-vos a dins si podeu."

#: src/core/overview/messages.py:32
msgid "Expect thunderstorms right now. Stay indoors if you can."
msgstr "Ara mateix s'esperen tempestes. Quedeu-vos a dins si podeu."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:36
#, python-brace-format
msgid "Thunderstorms are likely around {time}. Plan to be indoors by then."
msgstr ""
"És probable que hi hagi tempestes cap a les {time}. Mireu d'estar a cobert "
"abans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:38
#, python-brace-format
msgid "Expect thunderstorms around {time}. Plan to be indoors by then."
msgstr "S'esperen tempestes cap a les {time}. Mireu d'estar a cobert abans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:42
#, python-brace-format
msgid ""
"Thunderstorms are likely around {time} with {chance}% chance of rain. Be "
"indoors by then."
msgstr ""
"És probable que hi hagi tempestes cap a les {time}, amb una probabilitat de "
"pluja del {chance}%. Mireu d'estar a cobert abans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:44
#, python-brace-format
msgid ""
"Expect thunderstorms around {time}, with {chance}% chance of rain. Be "
"indoors by then."
msgstr ""
"S'esperen tempestes cap a les {time}, amb una probabilitat de pluja del "
"{chance}%. Mireu d'estar a cobert abans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "30"
#: src/core/overview/messages.py:48
#, python-brace-format
msgid ""
"Thunderstorms are possible around {time}, with {chance}% chance of rain."
msgstr ""
"Es poden produir tempestes cap a les {time}, amb una probabilitat de pluja "
"del {chance}%."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "30"
#: src/core/overview/messages.py:50
#, python-brace-format
msgid "Thunderstorms may come around {time}, with {chance}% chance of rain."
msgstr ""
"Podrien arribar tempestes cap a les {time}, amb una probabilitat de pluja "
"del {chance}%."

#. Translators: {time} is when the rain eases off, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:55
#, python-brace-format
msgid "Rain right now, turning stormy before it eases off around {time}."
msgstr ""
"Ara mateix plou, i hi haurà tempesta abans que amaini cap a les {time}."

#. Translators: {time} is when the rain eases off, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:57
#, python-brace-format
msgid "Rain for now, with thunderstorms before it clears around {time}."
msgstr ""
"De moment plou, i hi haurà tempestes abans que s'aclareixi cap a les {time}."

#. Translators: {time} is when the rain ends, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:61
#, python-brace-format
msgid "Rain right now, turning stormy later and lasting until about {time}."
msgstr ""
"Ara mateix plou; més tard hi haurà tempesta, i durarà fins a les {time}, "
"aproximadament."

#. Translators: {time} is when the rain ends, a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:63
#, python-brace-format
msgid "Expect rain until about {time}, with thunderstorms later on."
msgstr ""
"S'espera pluja fins a les {time}, aproximadament, amb tempestes més tard."

#. Translators: {time} is when the rain starts, a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:67
#, python-brace-format
msgid "Rain from around {time} with {chance}% chance, turning stormy later."
msgstr ""
"Pluja a partir de les {time}, amb una probabilitat del {chance}%, i tempesta "
"més tard."

#. Translators: {time} is when the rain starts, a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/core/overview/messages.py:69
#, python-brace-format
msgid ""
"Expect rain from around {time} with {chance}% chance, and thunderstorms "
"later on."
msgstr ""
"S'espera pluja a partir de les {time}, amb una probabilitat del {chance}%, i "
"tempestes més tard."

#. Translators: {speed} is a wind speed with its unit, like "45 km/h"
#: src/core/overview/messages.py:74
#, python-brace-format
msgid "Thunderstorms with strong wind, around {speed}, are likely right now."
msgstr ""
"Ara mateix és probable que hi hagi tempestes amb vent fort, d'uns {speed}."

#. Translators: {speed} is a wind speed with its unit, like "45 km/h"
#: src/core/overview/messages.py:76
#, python-brace-format
msgid "Expect thunderstorms with strong wind, around {speed}, right now."
msgstr "Ara mateix s'esperen tempestes amb vent fort, d'uns {speed}."

#. Translators: {speed} is a wind speed with its unit, like "45 km/h"; {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:80
#, python-brace-format
msgid ""
"Thunderstorms with strong wind, around {speed}, are likely from around "
"{time}."
msgstr ""
"És probable que hi hagi tempestes amb vent fort, d'uns {speed}, a partir de "
"les {time}."

#. Translators: {speed} is a wind speed with its unit, like "45 km/h"; {time} is a rounded time of day, like "6:30 PM"
#: src/core/overview/messages.py:82
#, python-brace-format
msgid ""
"Expect thunderstorms with strong wind, around {speed}, from around {time}."
msgstr ""
"S'esperen tempestes amb vent fort, d'uns {speed}, a partir de les {time}."

#: src/core/overview/messages.py:85
msgid "Thunderstorms with heavy rain are likely right now."
msgstr "Ara mateix és probable que hi hagi tempestes amb pluja forta."

#: src/core/overview/messages.py:86
msgid "Expect thunderstorms with heavy rain right now."
msgstr "Ara mateix s'esperen tempestes amb pluja forta."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
