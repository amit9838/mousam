#: src/CORE_OverviewMessages.py:31
msgid "Thunderstorms are likely right now. Stay indoors if you can."
msgstr "Most valószínűleg zivatar van. Ha teheti, maradjon bent."

#: src/CORE_OverviewMessages.py:32
msgid "Expect thunderstorms right now. Stay indoors if you can."
msgstr "Most zivatar várható. Ha teheti, maradjon bent."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:36
#, python-brace-format
msgid "Thunderstorms are likely around {time}. Plan to be indoors by then."
msgstr ""
"{time} körül valószínűleg zivatar lesz. Addigra érdemes fedett helyen lennie."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:38
#, python-brace-format
msgid "Expect thunderstorms around {time}. Plan to be indoors by then."
msgstr "{time} körül zivatar várható. Addigra érdemes fedett helyen lennie."

#: src/CORE_OverviewMessages.py:41
msgid "Freezing rain is likely right now. Roads and paths may be icy."
msgstr "Most valószínűleg ónos eső esik. Az utak és ösvények síkosak lehetnek."

#: src/CORE_OverviewMessages.py:42
msgid "Expect freezing rain right now. Watch for icy roads and paths."
msgstr "Most ónos eső várható. Vigyázzon a jeges utakon és ösvényeken."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:46
#, python-brace-format
msgid "Freezing rain is likely around {time}. Roads and paths may turn icy."
msgstr ""
"{time} körül valószínűleg ónos eső esik. Az utak és ösvények síkossá "
"válhatnak."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:48
#, python-brace-format
msgid "Expect freezing rain around {time}. Roads may turn icy."
msgstr "{time} körül ónos eső várható. Az utak síkossá válhatnak."

#: src/CORE_OverviewMessages.py:51
msgid "Heavy rain is likely right now. Expect puddles and slow roads."
msgstr ""
"Most valószínűleg heves eső esik. Számítson pocsolyákra és lassú forgalomra."

#: src/CORE_OverviewMessages.py:52
msgid "Expect heavy rain right now. Allow extra travel time."
msgstr "Most heves eső várható. Számítson hosszabb utazási időre."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:56
#, python-brace-format
msgid "Heavy rain is likely around {time}. Keep an umbrella close."
msgstr "{time} körül valószínűleg heves eső esik. Tartson kéznél esernyőt."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:58
#, python-brace-format
msgid "Expect heavy rain around {time}. Allow extra travel time."
msgstr "{time} körül heves eső várható. Számítson hosszabb utazási időre."

#: src/CORE_OverviewMessages.py:61
msgid "Heavy snow is likely right now. Travel may be slow."
msgstr "Most valószínűleg erős havazás van. A közlekedés lassú lehet."

#: src/CORE_OverviewMessages.py:62
msgid "Expect heavy snow right now. Allow extra travel time."
msgstr "Most erős havazás várható. Számítson hosszabb utazási időre."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:66
#, python-brace-format
msgid "Heavy snow is likely around {time}. Travel may be slow after that."
msgstr ""
"{time} körül valószínűleg erős havazás lesz. Utána a közlekedés lassú lehet."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:68
#, python-brace-format
msgid "Expect heavy snow around {time}. Allow extra travel time."
msgstr "{time} körül erős havazás várható. Számítson hosszabb utazási időre."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:72
#, python-brace-format
msgid "It feels like {temp} right now. Stay hydrated and seek shade."
msgstr "Most a hőérzet {temp}. Igyon sokat, és keressen árnyékot."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:74
#, python-brace-format
msgid "It feels as hot as {temp} right now. Drink water and stay cool."
msgstr "Most a hőérzet {temp}, nagy a meleg. Igyon vizet, és maradjon hűvösön."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:78
#, python-brace-format
msgid ""
"It will feel like {temp} by around {time}. Stay hydrated and seek shade."
msgstr "{time} körül a hőérzet {temp} lesz. Igyon sokat, és keressen árnyékot."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:80
#, python-brace-format
msgid ""
"Expect it to feel like {temp} by around {time}. Drink water and stay cool."
msgstr "{time} körül {temp} hőérzet várható. Igyon vizet, és maradjon hűvösön."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:84
#, python-brace-format
msgid "It feels like {temp} right now. Dress warmly, in layers."
msgstr "Most a hőérzet {temp}. Öltözzön melegen, rétegesen."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:86
#, python-brace-format
msgid "It feels as cold as {temp} right now. Bundle up."
msgstr "Most a hőérzet {temp}, csípős hideg van. Öltözzön fel jól."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:90
#, python-brace-format
msgid "It will feel like {temp} by around {time}. Dress warmly, in layers."
msgstr "{time} körül a hőérzet {temp} lesz. Öltözzön melegen, rétegesen."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:92
#, python-brace-format
msgid "Expect it to feel like {temp} by around {time}. Bundle up."
msgstr "{time} körül {temp} hőérzet várható. Öltözzön fel jól."

#: src/CORE_OverviewMessages.py:95
msgid "Air quality is unhealthy right now. Limit time outdoors if you can."
msgstr ""
"A levegő minősége most egészségtelen. Ha teheti, töltsön kevesebb időt a "
"szabadban."

#: src/CORE_OverviewMessages.py:96
msgid "The air is unhealthy right now. Consider staying indoors."
msgstr "A levegő most egészségtelen. Fontolja meg, hogy bent marad."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:100
#, python-brace-format
msgid ""
"Air quality turns unhealthy around {time}. Consider limiting time outdoors."
msgstr ""
"A levegő minősége {time} körül egészségtelenné válik. Fontolja meg, hogy "
"kevesebb időt tölt a szabadban."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:102
#, python-brace-format
msgid "Expect unhealthy air from around {time}. Limit time outdoors."
msgstr ""
"Egészségtelen levegő várható {time} körüli időponttól. Töltsön kevesebb időt "
"a szabadban."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:106
#, python-brace-format
msgid "UV is very high until about {time}. Use sunscreen and cover up."
msgstr ""
"Az UV-sugárzás nagyon erős {time} körüli időpontig. Használjon naptejet, és "
"fedje be magát."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:108
#, python-brace-format
msgid ""
"The sun is very strong until about {time}. Use sunscreen and seek shade."
msgstr ""
"A nap nagyon erős {time} körüli időpontig. Használjon naptejet, és keressen "
"árnyékot."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:112
#, python-brace-format
msgid ""
"UV will be very high from about {start} to {end}. Use sunscreen outdoors."
msgstr ""
"Az UV-sugárzás körülbelül {start} és {end} között nagyon erős lesz. A "
"szabadban használjon naptejet."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:114
#, python-brace-format
msgid "Expect very high UV from about {start} to {end}. Cover up outdoors."
msgstr ""
"Körülbelül {start} és {end} között nagyon erős UV-sugárzás várható. A "
"szabadban fedje be magát."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:119
#, python-brace-format
msgid "Rain is likely to start around {time} with {chance}% chance."
msgstr "Az eső valószínűleg {time} körül kezdődik, {chance}% eséllyel."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:121
#, python-brace-format
msgid "Expect rain from around {time}, with {chance}% chance."
msgstr "Eső várható {time} körüli időponttól, {chance}% eséllyel."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:123
