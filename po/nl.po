#: src/CORE_OverviewMessages.py:31
msgid "Thunderstorms are likely right now. Stay indoors if you can."
msgstr "Er is nu kans op onweer. Blijf binnen als je kunt."

#: src/CORE_OverviewMessages.py:32
msgid "Expect thunderstorms right now. Stay indoors if you can."
msgstr "Verwacht nu onweer. Blijf binnen als je kunt."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:36
#, python-brace-format
msgid "Thunderstorms are likely around {time}. Plan to be indoors by then."
msgstr "Rond {time} is er kans op onweer. Zorg dat je er dan binnen bent."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:38
#, python-brace-format
msgid "Expect thunderstorms around {time}. Plan to be indoors by then."
msgstr "Verwacht rond {time} onweer. Zorg dat je er dan binnen bent."

#: src/CORE_OverviewMessages.py:41
msgid "Freezing rain is likely right now. Roads and paths may be icy."
msgstr "Er is nu kans op ijzel. Wegen en paden kunnen glad zijn."

#: src/CORE_OverviewMessages.py:42
msgid "Expect freezing rain right now. Watch for icy roads and paths."
msgstr "Verwacht nu ijzel. Pas op voor gladde wegen en paden."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:46
#, python-brace-format
msgid "Freezing rain is likely around {time}. Roads and paths may turn icy."
msgstr "Rond {time} is er kans op ijzel. Wegen en paden kunnen glad worden."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:48
#, python-brace-format
msgid "Expect freezing rain around {time}. Roads may turn icy."
msgstr "Verwacht rond {time} ijzel. Wegen kunnen glad worden."

#: src/CORE_OverviewMessages.py:51
msgid "Heavy rain is likely right now. Expect puddles and slow roads."
msgstr ""
"Er is nu kans op zware regen. Verwacht plassen en een trage doorstroming."

#: src/CORE_OverviewMessages.py:52
msgid "Expect heavy rain right now. Allow extra travel time."
msgstr "Verwacht nu zware regen. Reken op extra reistijd."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:56
#, python-brace-format
msgid "Heavy rain is likely around {time}. Keep an umbrella close."
msgstr "Rond {time} is er kans op zware regen. Houd een paraplu bij de hand."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:58
#, python-brace-format
msgid "Expect heavy rain around {time}. Allow extra travel time."
msgstr "Verwacht rond {time} zware regen. Reken op extra reistijd."

#: src/CORE_OverviewMessages.py:61
msgid "Heavy snow is likely right now. Travel may be slow."
msgstr "Er is nu kans op zware sneeuwval. Reizen kan traag verlopen."

#: src/CORE_OverviewMessages.py:62
msgid "Expect heavy snow right now. Allow extra travel time."
msgstr "Verwacht nu zware sneeuwval. Reken op extra reistijd."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:66
#, python-brace-format
msgid "Heavy snow is likely around {time}. Travel may be slow after that."
msgstr ""
"Rond {time} is er kans op zware sneeuwval. Daarna kan reizen traag verlopen."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:68
#, python-brace-format
msgid "Expect heavy snow around {time}. Allow extra travel time."
msgstr "Verwacht rond {time} zware sneeuwval. Reken op extra reistijd."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:72
#, python-brace-format
msgid "It feels like {temp} right now. Stay hydrated and seek shade."
msgstr "Het voelt nu als {temp}. Drink genoeg en zoek de schaduw op."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:74
#, python-brace-format
msgid "It feels as hot as {temp} right now. Drink water and stay cool."
msgstr "Het voelt nu zo heet als {temp}. Drink water en blijf koel."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:78
#, python-brace-format
msgid ""
"It will feel like {temp} by around {time}. Stay hydrated and seek shade."
msgstr "Rond {time} voelt het als {temp}. Drink genoeg en zoek de schaduw op."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:80
#, python-brace-format
msgid ""
"Expect it to feel like {temp} by around {time}. Drink water and stay cool."
msgstr ""
"Verwacht rond {time} een gevoelstemperatuur van {temp}. Drink water en blijf "
"koel."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:84
#, python-brace-format
msgid "It feels like {temp} right now. Dress warmly, in layers."
msgstr "Het voelt nu als {temp}. Kleed je warm aan, in lagen."

#. Translators: {temp} is a temperature, like "14°"
#: src/CORE_OverviewMessages.py:86
#, python-brace-format
msgid "It feels as cold as {temp} right now. Bundle up."
msgstr "Het voelt nu zo koud als {temp}. Kleed je goed warm aan."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:90
#, python-brace-format
msgid "It will feel like {temp} by around {time}. Dress warmly, in layers."
msgstr "Rond {time} voelt het als {temp}. Kleed je warm aan, in lagen."

#. Translators: {temp} is a temperature, like "14°"; {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:92
#, python-brace-format
msgid "Expect it to feel like {temp} by around {time}. Bundle up."
msgstr ""
"Verwacht rond {time} een gevoelstemperatuur van {temp}. Kleed je goed warm "
"aan."

#: src/CORE_OverviewMessages.py:95
msgid "Air quality is unhealthy right now. Limit time outdoors if you can."
msgstr "De luchtkwaliteit is nu ongezond. Beperk je tijd buiten als je kunt."

#: src/CORE_OverviewMessages.py:96
msgid "The air is unhealthy right now. Consider staying indoors."
msgstr "De lucht is nu ongezond. Overweeg om binnen te blijven."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:100
#, python-brace-format
msgid ""
"Air quality turns unhealthy around {time}. Consider limiting time outdoors."
msgstr ""
"De luchtkwaliteit wordt rond {time} ongezond. Overweeg je tijd buiten te "
"beperken."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:102
#, python-brace-format
msgid "Expect unhealthy air from around {time}. Limit time outdoors."
msgstr "Verwacht vanaf ongeveer {time} ongezonde lucht. Beperk je tijd buiten."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:106
#, python-brace-format
msgid "UV is very high until about {time}. Use sunscreen and cover up."
msgstr ""
"De uv-index is zeer hoog tot ongeveer {time}. Gebruik zonnebrandcrème en "
"bedek je huid."

#. Translators: {time} is a rounded time of day, like "6:30 PM"
#: src/CORE_OverviewMessages.py:108
#, python-brace-format
msgid ""
"The sun is very strong until about {time}. Use sunscreen and seek shade."
msgstr ""
"De zon is zeer sterk tot ongeveer {time}. Gebruik zonnebrandcrème en zoek de "
"schaduw op."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:112
#, python-brace-format
msgid ""
"UV will be very high from about {start} to {end}. Use sunscreen outdoors."
msgstr ""
"De uv-index is zeer hoog van ongeveer {start} tot {end}. Gebruik buiten "
"zonnebrandcrème."

#. Translators: {start} and {end} are rounded times of day, like "11:00 AM" and "3:00 PM"
#: src/CORE_OverviewMessages.py:114
#, python-brace-format
msgid "Expect very high UV from about {start} to {end}. Cover up outdoors."
msgstr ""
"Verwacht van ongeveer {start} tot {end} een zeer hoge uv-index. Bedek je "
"huid buiten."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:119
#, python-brace-format
msgid "Rain is likely to start around {time} with {chance}% chance."
msgstr "Het gaat waarschijnlijk rond {time} regenen, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:121
#, python-brace-format
msgid "Expect rain from around {time}, with {chance}% chance."
msgstr "Verwacht vanaf ongeveer {time} regen, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:123
#, python-brace-format
msgid "Rain may move in around {time} with {chance}% chance."
msgstr "Rond {time} kan er regen komen, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:125
#, python-brace-format
msgid ""
"Showers could begin around {time} with {chance}% chance. Keep an umbrella "
"handy."
msgstr ""
"Rond {time} kunnen er buien beginnen, met {chance}% kans. Houd een paraplu "
"bij de hand."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:127
#, python-brace-format
msgid "There is {chance}% chance of rain starting around {time}."
msgstr "Er is {chance}% kans dat het rond {time} gaat regenen."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:131
#, python-brace-format
msgid "Snow is likely to start around {time} with {chance}% chance."
msgstr "Het gaat waarschijnlijk rond {time} sneeuwen, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:133
#, python-brace-format
msgid "Expect snow from around {time}, with {chance}% chance."
msgstr "Verwacht vanaf ongeveer {time} sneeuw, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
#: src/CORE_OverviewMessages.py:135
#, python-brace-format
msgid "Snow may move in around {time} with {chance}% chance."
msgstr "Rond {time} kan er sneeuw komen, met {chance}% kans."

#. Translators: {time} is a rounded time of day, like "6:30 PM"; {chance} is a percentage, like "70"
